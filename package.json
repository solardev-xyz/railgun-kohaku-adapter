{
  "name": "@freedom/railgun-kohaku-adapter",
  "version": "0.3.0",
  "private": true,
  "description": "Restricted Kohaku adapters and historical Railgun capsule data readers (Sepolia qualification policy)",
  "license": "MPL-2.0",
  "main": "./index.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./read": {
      "import": {
        "types": "./types/read.d.mts",
        "default": "./read.mjs"
      },
      "require": {
        "types": "./types/read.d.ts",
        "default": "./read.cjs"
      }
    },
    "./data": {
      "import": {
        "types": "./types/data.d.mts",
        "default": "./data.mjs"
      },
      "require": {
        "types": "./types/data.d.ts",
        "default": "./data.cjs"
      }
    },
    "./host/data": {
      "import": {
        "types": "./types/host-data.d.mts",
        "default": "./host-data.mjs"
      },
      "require": {
        "types": "./types/host-data.d.ts",
        "default": "./host-data.cjs"
      }
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "read.cjs",
    "read.mjs",
    "src/",
    "types/",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "data.cjs",
    "data.mjs",
    "host-data.cjs",
    "host-data.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "node test/types/typecheck.cjs"
  },
  "peerDependencies": {
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@kohaku-eth/plugins": "0.0.1-alpha.16",
    "ethers": "6.17.0",
    "jest": "30.5.2"
  }
}
