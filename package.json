      },
      "require": {
        "types": "./types/host-owner-authority.d.ts",
        "default": "./host-owner-authority.cjs"
      }
    },
    "./host/owner-worker-bootstrap": {
      "types": "./types/host-owner-worker-bootstrap.d.ts",
      "default": "./host-owner-worker-bootstrap.cjs"
    }
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "read.cjs",
    "read.mjs",
    "src/",
    "types/",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "data.cjs",
    "data.mjs",
    "host-data.cjs",
    "host-data.mjs",
    "host-poi.cjs",
    "host-poi.mjs",
    "host-execution.cjs",
    "host-execution.mjs",
