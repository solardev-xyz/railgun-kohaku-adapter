{
  "name": "@freedom/railgun-kohaku-adapter",
  "version": "0.6.0",
  "private": true,
  "description": "Kohaku Railgun adapters with fixed account owners and private utility execution",
  "license": "MPL-2.0",
  "main": "./index.cjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./types/index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./types/index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./read": {
      "import": {
        "types": "./types/read.d.mts",
