  "scripts": {
    "test": "jest",
    "typecheck": "node test/types/typecheck.cjs",
    "lint": "eslint . --max-warnings 0"
  },
  "peerDependencies": {
    "better-sqlite3": "13.0.3",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
